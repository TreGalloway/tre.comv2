---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const favorites = await getCollection('favorites');
---

<Layout title="Things I Enjoy" description="Things I enjoy - manga, comics, anime, books, games, and movies">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-10">
      <p class="mb-4 text-[11px] uppercase tracking-widest text-ink-soft">
        Things I Enjoy
      </p>
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Things I enjoy
      </h1>
      <p class="mt-4 text-lg text-ink-soft">
        A collection of things I enjoy - manga, comics, anime, books (ebook, physical, and audio), games, and movies.
      </p>
    </div>
    {favorites.length > 0 ? (
      <div class="space-y-10">
        {favorites.map((entry) => (
          <section>
            <h2 class="mb-4 text-lg font-semibold text-ink">{entry.data.title}</h2>
            <ul class="space-y-3">
              {entry.data.items.map((item) => (
                <li class="rounded-lg border border-line bg-surface/40 p-4">
                  {item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-ink hover:underline"
                    >
                      {item.name}
                    </a>
                  ) : (
                    <h3 class="font-medium text-ink">{item.name}</h3>
                  )}
                  {item.description && (
                    <p class="mt-1 text-sm text-ink-soft">{item.description}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="text-sm text-ink-soft">Nothing here yet.</p>
    )}
  </section>
</Layout>
---
export const prerender = true;
