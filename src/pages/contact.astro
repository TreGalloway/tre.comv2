---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import { getContact } from '@/lib/content';

const contact = await getContact();
export const prerender = true;
---

<Layout title="Contact" description={contact.intro}>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="max-w-2xl">
      <p class="mb-4 text-[11px] uppercase tracking-widest text-ink-soft">
        {contact.eyebrow}
      </p>
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {contact.heading}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-soft">
        {contact.intro}
      </p>
      <div class="mt-8">
        <Button href={contact.cta.href}>{contact.cta.label}</Button>
      </div>
    </div>
  </section>
</Layout>
