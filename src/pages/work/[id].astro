---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('work', ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const { title, summary, role, date, tags, url, repo, liveLabel, codeLabel, seo } =
  work.data;
export const prerender = true;
---

<Layout title={title} description={summary} seo={seo}>
  <article class="mx-auto max-w-3xl px-6 py-20">
    <header class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-4 text-xs text-ink-soft">
        <span class="uppercase tracking-widest">{role}</span>
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {tags.map((tag) => (
          <span class="rounded-full border border-line bg-surface/60 px-2 py-0.5">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {title}
      </h1>
      {summary && (
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{summary}</p>
      )}
      <div class="mt-6 flex gap-3">
        {url && <Button href={url}>{liveLabel}</Button>}
        {repo && (
          <Button href={repo} variant="ghost">
            {codeLabel}
          </Button>
        )}
      </div>
    </header>
    <div class="prose prose-neutral max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</Layout>
