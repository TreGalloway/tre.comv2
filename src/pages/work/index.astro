---
import Layout from '@/layouts/Layout.astro';
import WorkCard from '@/components/WorkCard.astro';
import { getCollection, getEntry } from 'astro:content';

const entry = await getEntry('pages', 'work-index');
if (!entry || entry.data.kind !== 'index') {
  throw new Error('Missing pages/work-index.mdx');
}
const page = entry.data;

const works = await getCollection('work', ({ data }) => !data.draft);
works.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
export const prerender = true;
---

<Layout title="Work" description={page.intro}>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="mb-10 max-w-2xl">
      <p class="mb-4 text-[11px] uppercase tracking-widest text-ink-soft">
        {page.eyebrow}
      </p>
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {page.heading}
      </h1>
      <p class="mt-4 text-lg text-ink-soft">{page.intro}</p>
    </div>
    {works.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {works.map((work) => (
          <WorkCard work={work} />
        ))}
      </div>
    ) : (
      <p class="text-sm text-ink-soft">{page.emptyText}</p>
    )}
  </section>
</Layout>
