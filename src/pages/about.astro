---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'about');
if (!entry || entry.data.kind !== 'about') {
  throw new Error('Missing pages/about.mdx');
}
const about = entry.data;
export const prerender = true;
---

<Layout title="About" description={about.intro}>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-10">
      <p class="mb-4 text-[11px] uppercase tracking-widest text-ink-soft">
        {about.eyebrow}
      </p>
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {about.heading}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{about.intro}</p>
    </div>

    <div class="space-y-10">
      <section>
        <h2 class="mb-4 text-lg font-semibold text-ink">
          {about.education.heading}
        </h2>
        <div class="space-y-4">
          {about.education.items.map((item) => (
            <div class="rounded-lg border border-line bg-surface/40 p-4">
              <h3 class="font-medium text-ink">{item.institution}</h3>
              {item.detail && (
                <p class="mt-1 text-sm text-ink-soft">{item.detail}</p>
              )}
              {item.status && (
                <p class="mt-1 text-sm text-ink-soft">{item.status}</p>
              )}
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-lg font-semibold text-ink">
          {about.focusAreas.heading}
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {about.focusAreas.items.map((item) => (
            <li class="rounded-lg border border-line bg-surface/40 p-4">
              <h3 class="font-medium text-ink">{item.label}</h3>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="mb-4 text-lg font-semibold text-ink">
          {about.location.heading}
        </h2>
        <p class="text-sm text-ink-soft">{about.location.text}</p>
      </section>

      <div class="pt-4">
        <Button href={about.cta.href}>{about.cta.label}</Button>
      </div>
    </div>
  </section>
</Layout>
