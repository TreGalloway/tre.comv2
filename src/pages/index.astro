---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import { getEntry } from 'astro:content';
import { SITE } from '@/site.config';
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';
import { Button as SwButton } from '@/components/starwind/button';

const entry = await getEntry('pages', 'home');
if (!entry || entry.data.kind !== 'home') {
  throw new Error('Missing pages/home.mdx');
}
const home = entry.data;
export const prerender = true;
---

<Layout title="Home" description={home.hero.subheading}>
  <section class="mx-auto max-w-5xl px-6 pt-8 pb-16 sm:pt-12">
    <div class="max-w-2xl">
      <p class="mb-4 text-[11px] font-medium uppercase tracking-widest text-ink-soft">
        {home.hero.eyebrow}
      </p>
      <div class="flex items-center gap-5">
        {SITE.avatar ? (
          <img
            src={SITE.avatar}
            alt={SITE.name}
            class="h-16 w-16 shrink-0 rounded-full border border-line object-cover"
          />
        ) : (
          <div
            class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-accent text-xl font-semibold text-paper"
            aria-hidden="true"
          >
            TG
          </div>
        )}
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          {home.hero.heading}
        </h1>
      </div>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        {home.hero.subheading}
      </p>
      <div class="mt-8 flex items-center gap-4">
        <Button href={home.hero.primaryCta.href}>
          {home.hero.primaryCta.label}
        </Button>
        {home.hero.secondaryCta && (
          <Button href={home.hero.secondaryCta.href} variant="ghost">
            {home.hero.secondaryCta.label}
          </Button>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="mb-8">
      <p class="mb-2 text-[11px] font-medium uppercase tracking-widest text-ink-soft">
        {home.pillars.eyebrow}
      </p>
      <h2 class="text-2xl font-semibold tracking-tight text-ink">
        {home.pillars.heading}
      </h2>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {home.pillars.items.map((pillar) => (
        <Card class="relative w-full">
          <CardHeader>
            <CardTitle>{pillar.title}</CardTitle>
            <CardDescription>{pillar.description}</CardDescription>
          </CardHeader>
          <CardFooter>
            <SwButton as="a" href={pillar.href} class="w-full">
              {pillar.ctaLabel}
            </SwButton>
          </CardFooter>
        </Card>
      ))}
    </div>
  </section>
</Layout>
