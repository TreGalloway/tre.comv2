---
import Layout from '@/layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'uses-index');
if (!entry || entry.data.kind !== 'index') {
  throw new Error('Missing pages/uses-index.mdx');
}
const page = entry.data;

const entries = await getCollection('uses');
const uses = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
export const prerender = true;
---

<Layout title="Uses" description={page.intro}>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-10">
      <p class="mb-4 text-[11px] uppercase tracking-widest text-ink-soft">
        {page.eyebrow}
      </p>
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {page.heading}
      </h1>
      <p class="mt-4 text-lg text-ink-soft">{page.intro}</p>
    </div>
    {uses.length > 0 ? (
      <div class="space-y-10">
        {uses.map(({ entry, Content }) => (
          <section>
            <h2 class="mb-4 text-lg font-semibold text-ink">{entry.data.title}</h2>
            <div class="prose prose-neutral mb-4 max-w-none dark:prose-invert">
              <Content />
            </div>
            <ul class="space-y-3">
              {entry.data.items.map((item) => (
                <li class="rounded-lg border border-line bg-surface/40 p-4">
                  <h3 class="font-medium text-ink">{item.name}</h3>
                  {item.description && (
                    <p class="mt-1 text-sm text-ink-soft">{item.description}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="text-sm text-ink-soft">{page.emptyText}</p>
    )}
  </section>
</Layout>
