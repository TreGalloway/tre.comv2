---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'not-found');
if (!entry || entry.data.kind !== 'not-found') {
  throw new Error('Missing pages/not-found.mdx');
}
const notFound = entry.data;
export const prerender = true;
---

<Layout title={notFound.heading} description={notFound.message}>
  <section class="mx-auto flex max-w-5xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="mb-4 text-[11px] uppercase tracking-widest text-ink-soft">
      {notFound.eyebrow}
    </p>
    <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      {notFound.heading}
    </h1>
    <p class="mt-4 max-w-md text-lg text-ink-soft">
      {notFound.message}
    </p>
    <div class="mt-8">
      <Button href={notFound.cta.href}>{notFound.cta.label}</Button>
    </div>
  </section>
</Layout>
