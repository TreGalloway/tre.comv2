---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import { SEO } from '@/seo.config';

interface Props {
  title: string;
  description?: string;
  seo?: {
    metaTitle?: string | null;
    metaDescription?: string | null;
    ogImage?: string | null;
  } | null;
}

const { title, description, seo } = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? SITE.url ?? 'https://tregalloway.com',
).href;
---

<html lang="en" data-theme="serendipity">
  <head>
    <BaseHead
      title={seo?.metaTitle || title}
      description={seo?.metaDescription || description || SEO.defaultDescription}
      ogImage={seo?.ogImage || SEO.defaultOgImage}
      titleTemplate={SEO.titleTemplate}
      twitterHandle={SEO.twitterHandle}
      canonical={canonical}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
