---
interface Props {
  title?: string;
}

const { title = 'tech-stack.json' } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-line bg-surface/40 text-sm">
  <div class="flex items-center gap-2 border-b border-line px-4 py-2 text-xs text-ink-soft">
    <span class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full" style="background:#e06c75" />
      <span class="h-2.5 w-2.5 rounded-full" style="background:#e5c07b" />
      <span class="h-2.5 w-2.5 rounded-full" style="background:#98c379" />
    </span>
    <span class="font-mono">{title}</span>
  </div>
  <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed"><code><slot /></code></pre>
</div>