---
import { SITE } from '@/site.config';
import ThemeToggle from './ThemeToggle.astro';

const nav = SITE.nav.filter((link) => link.visible);
---

<header class="border-b border-line bg-paper/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="text-sm font-medium tracking-tight text-ink">
      {SITE.logo ? (
        <img src={SITE.logo} alt={SITE.name} class="h-6 w-auto" />
      ) : (
        SITE.name
      )}
    </a>
    <nav class="hidden items-center gap-6 sm:flex">
      {nav.map((link) => (
        <a
          href={link.href}
          class="text-sm text-ink-soft transition-colors hover:text-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="command-palette-trigger"
        class="flex items-center gap-2 rounded-lg border border-line bg-surface/50 px-3 py-1.5 text-xs text-ink-soft transition-colors hover:text-ink"
        aria-label="Open command palette"
      >
        <span>Search</span>
        <span class="flex items-center gap-1">
          <kbd class="rounded border border-line bg-surface px-1.5 py-0.5 font-mono text-[10px]">⌘</kbd>
          <kbd class="rounded border border-line bg-surface px-1.5 py-0.5 font-mono text-[10px]">K</kbd>
        </span>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>
