---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---

<article class="group relative flex flex-col gap-3 rounded-xl border border-line bg-surface/40 p-6 transition-colors hover:border-ink/20 hover:bg-surface/60">
  <div class="flex items-center justify-between text-xs text-ink-soft">
    <span class="uppercase tracking-widest">{category}</span>
    <time datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      })}
    </time>
  </div>
  <h3 class="text-lg font-semibold tracking-tight text-ink">
    <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 after:block">
      {title}
    </a>
  </h3>
  <p class="text-sm leading-relaxed text-ink-soft">{description}</p>
</article>
